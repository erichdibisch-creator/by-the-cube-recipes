order-radius:30px;padding:5px 10px;font-size:12px;color:#345441}.macros{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:15px 0}.macro{background:#f2f4ee;padding:10px 4px;text-align:center;border-radius:9px}.macro strong{display:block;font-size:19px}.macro small{color:var(--muted);font-size:10px}.controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0}.controls input{width:66px;border:1px solid #ccd5ca;padding:7px;border-radius:8px}.section{border-top:1px solid var(--line);margin-top:18px;padding-top:2px}ul,ol{padding-left:22px;margin-top:8px}li{margin:5px 0}.note{background:#fff5e9;border-left:3px solid #d79750;padding:10px 12px;border-radius:5px;font-size:13px;margin-top:14px}.builder{margin:36px 0 20px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px}.builder h2{margin-top:0}.builder-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.build-item{background:#f4f6f1;padding:14px;border-radius:12px}.build-item strong{display:block;min-height:48px}.build-item input{width:100%;margin-top:10px}.total{display:flex;gap:20px;flex-wrap:wrap;margin-top:18px;padding:17px;background:#203a2c;color:white;border-radius:12px}.total span{font-size:13px}.total b{font-size:24px;display:block}.disclaimer{font-size:12px;color:var(--muted);max-width:900px;margin:26px 0}.footer{border-top:1px solid var(--line);padding-top:18px;color:var(--muted);font-size:12px}a{color:#a7442b}#empty{display:none;padding:35px;text-align:center}@media(max-width:780px){.cards{grid-template-columns:1fr}.builder-grid{grid-template-columns:repeat(2,1fr)}.photo{height:210px}}@media print{header{padding:20px;color:#20302a;background:white}.toolbar,.builder,button{display:none!important}.cards{display:block}.card{break-inside:avoid;margin-bottom:20px;box-shadow:none}.photo{height:130px}main{padding:10px}.body{padding:14px}}

